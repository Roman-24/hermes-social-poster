# Local development only. In production everything sensitive comes from Podman secrets / the DB.
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
INBOX_DIR=./data/inbox
INBOX_HOST_PREFIX=./data/inbox
# Generate a dev master key under DATA_DIR instead of reading /run/secrets/poster_master_key
POSTER_DEV_AUTOKEY=1
# Replace every network with the in-memory fake adapter (nothing is published)
POSTER_FAKE_ADAPTERS=1
# Bootstrap tokens/passwords for development (use `poster gen-token` / the UI in production)
POSTER_MCP_TOKEN=dev-mcp-token
POSTER_UI_PASSWORD=dev-password-change-me
LOG_LEVEL=debug
LOG_PRETTY=1
CHROMIUM_PATH=/opt/pw-browsers/chromium
