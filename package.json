{
  "name": "hermes-social-poster",
  "version": "0.1.0",
  "private": true,
  "description": "Single-user social publishing service for Hermes: X, Farcaster, LinkedIn, Nostr and Bluesky via MCP + REST, with SimpleX confirmation codes.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @poster/web build && pnpm --filter @poster/server build",
    "dev": "pnpm --filter @poster/server dev",
    "dev:web": "pnpm --filter @poster/web dev",
    "start": "pnpm --filter @poster/server start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @poster/server db:generate",
    "cli": "pnpm --filter @poster/server cli"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
